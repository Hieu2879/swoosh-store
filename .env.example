# Cổng kết nối máy chủ (mặc định 8000, nền tảng Cloud tự cấp $PORT)
PORT=8000

# Địa chỉ IP máy chủ lắng nghe (0.0.0.0 để chấp nhận truy cập bên ngoài trên Cloud/VPS)
SWOOSH_HOST=0.0.0.0

# Bắt buộc bật (1) khi chạy trên tên miền công khai có HTTPS
SWOOSH_COOKIE_SECURE=1

# Đường dẫn lưu trữ cơ sở dữ liệu SQLite
SWOOSH_DB=data/swoosh.sqlite3

# Bật (1) khi đứng sau Reverse Proxy (Nginx, Cloudflare, Traefik, Render load balancer)
TRUST_PROXY=1

# (Tùy chọn) Mật khẩu Admin ban đầu khi tạo tự động qua Docker / CI-CD
# SWOOSH_ADMIN_USERNAME=admin
# SWOOSH_ADMIN_PASSWORD=MatKhauBaoMat123456!
